{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creativecontactbench.local/schemas/vlm_response_v1.0.schema.json",
  "title": "CreativeContactBench VLM evaluator response v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ratings", "overall_ranking", "confidence"],
  "properties": {
    "ratings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": {"$ref": "#/$defs/optionRating"},
        "B": {"$ref": "#/$defs/optionRating"},
        "C": {"$ref": "#/$defs/optionRating"},
        "D": {"$ref": "#/$defs/optionRating"}
      }
    },
    "overall_ranking": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {"type": "string", "enum": ["A", "B", "C", "D"]}
      }
    },
    "confidence": {"type": "integer", "minimum": 1, "maximum": 5}
  },
  "$defs": {
    "optionRating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_task_effectiveness",
        "embodied_feasibility",
        "functional_creativity"
      ],
      "properties": {
        "expected_task_effectiveness": {"type": "integer", "minimum": 1, "maximum": 5},
        "embodied_feasibility": {"type": "integer", "minimum": 1, "maximum": 5},
        "functional_creativity": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    }
  }
}
